{
  "manifest_version": 3,
  "name": "Tactical Archive - 戦術対抗戦 履歴管理",
  "version": "1.1.15",
  "description": "ブルーアーカイブ戦術対抗戦の対戦履歴をスクリーンショットから自動認識・記録・分析するローカルツール",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Tactical Archive を開く",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "icon.png",
        "favicon.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}